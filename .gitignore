# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Local secrets
.env

# Local MCP server config (may contain secrets)
tools/mcp/mcp.json
# Local SSL CA bundle for MCP servers
tools/mcp/ssl/

# Local dev process logs / pids (langgraph dev, next dev)
.run/

# Machine-local runtime data (checkpoints, profiles, logs, offload store)
# Generated at repo root by the agent runtime; never commit.
checkpoints.sqlite
checkpoints.sqlite-shm
checkpoints.sqlite-wal
agent/profiles/
agent/react/
logs/
offload_store/

# OS junk
.DS_Store

.idea/

# LangGraph API
.langgraph_api/

# Frontend (Next.js / CopilotKit) — only cache / deps, source stays tracked
frontend/node_modules/
frontend/.next/
frontend/.next/dev/
frontend/tsconfig.tsbuildinfo
frontend/.DS_Store
frontend/**/.DS_Store
frontend/out/
frontend/build/