# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Local env (non-secret) and secrets
.env
secrets.env

# Local MCP server config (may contain secrets)
config/mcp.json

# All runtime files: checkpoints, profiles, logs, offload store, workspace, dev
# server PIDs/logs (run/), langgraph dev store (langgraph/), Qdrant binary and
# data (qdrant/), RAG job files (rag-jobs/). See config/README.md.
.local/

.idea/

# LangGraph dev store, if `langgraph dev` is started outside scripts/dev.sh
.langgraph_api/

# Frontend (Next.js / CopilotKit) — only cache / deps, source stays tracked
# Stray Next.js cache from running `next dev` at the repo root (the app lives in frontend/)
/.next/
frontend/node_modules/
frontend/.next/
frontend/.next/dev/
frontend/tsconfig.tsbuildinfo
frontend/.DS_Store
frontend/**/.DS_Store
frontend/out/
frontend/build/
# macOS Finder metadata
.DS_Store

# Legacy virtualenv (project uses .venv via uv)
venv/

# MkDocs GitHub Pages build
site/
