{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": ".venv/bin/langgraph",
      "runtimeArgs": ["dev", "--no-browser", "--port", "8000", "--allow-blocking"],
      "port": 8000
