"data:image/svg+xml,<?xml version=\"1.0\" encoding=\"utf-8\"?>%0A<!--%0A  CopilotKit Kite mark. Artwork copied verbatim from the official small-size%0A  export (website public/icons/copilotkit-kite.svg) - do not redraw it.%0A%0A  The only change is the viewBox: every path is untouched, so this is a window%0A  onto the artwork rather than a redrawing, and it is reversible.%0A%0A  The source is not centred in its own box. A hairline string runs from the kite%0A  to the far lower-left (x 0.16, y 26.36) and drags the bounding box with it, so%0A  centring on everything leaves the kite up and to the right - measured, 7.3 px%0A  right and 6.7 px high at a 112 px render.%0A%0A  The box below is centred on the SAILS instead, which is the only part a reader%0A  can recognise at this size. Sail bounds are x 6.34..20.60, y 3.70..20.83,%0A  centre (13.47, 12.26); the box is that centre with a square side of 17.8,%0A  giving roughly 2% of air on every edge.%0A%0A  Consequences, all deliberate: the string and the tail ribbon fall outside the%0A  window. At a 20 px render the string's 0.30-unit stroke is under one device%0A  pixel and cannot draw as a line, and the tail becomes three or four muddy%0A  pixels, so they cost about 40% of the box and return almost nothing. Dropping%0A  them puts the kite at 53% of the launcher's height instead of 38%.%0A%0A  If the artwork is ever re-exported, check the sail bounds again before trusting%0A  this box: the 2% margin absorbs small drift, not a re-composition.%0A-->%0A<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"4.57 3.36 17.8 17.8\" fill=\"none\">%0A<path d=\"M6.36084 10.9855C8.34277 8.393 9.98843 5.82939 10.6204 3.75914C10.6382 3.70281 10.7043 3.67888 10.7534 3.7114C12.9536 5.16894 16.9635 6.12833 20.5086 6.15085C20.5703 6.15124 20.6124 6.2114 20.5895 6.26829C19.4109 9.25938 17.9705 14.6189 17.9148 20.7392C17.9148 20.8301 17.7873 20.8627 17.7419 20.7837C15.7236 17.2522 9.26021 12.2898 6.39414 11.1186C6.34112 11.0968 6.32556 11.0313 6.36084 10.9855Z\" fill=\"url(%23paint0_linear)\"/>%0A<path d=\"M13.0475 9.39974C9.95016 10.3806 7.11935 10.9259 6.44331 11.0498C6.40027 11.0577 6.39115 11.1172 6.43152 11.134C9.3203 12.3347 15.7516 17.2826 17.7511 20.7998C17.7551 20.8075 17.7647 20.8103 17.7728 20.8068C17.7809 20.803 17.7853 20.793 17.7819 20.7844L13.0475 9.39974Z\" fill=\"url(%23paint1_linear)\"/>%0A<path d=\"M10.762 3.705C13.4137 5.15161 16.4787 5.80132 20.545 6.14367C20.5703 6.14585 20.5787 6.18008 20.5557 6.19197C20.0359 6.45923 17.0574 7.97512 14.8455 8.78701C14.2524 9.00453 13.6564 9.20632 13.0692 9.39249C13.0562 9.39656 13.0419 9.39015 13.0369 9.37774L10.7005 3.75979C10.6849 3.72196 10.7257 3.68538 10.762 3.705Z\" fill=\"url(%23paint2_linear)\"/>%0A<path d=\"M10.7145 3.79041L17.8305 20.7659\" stroke=\"%23513C9F\" stroke-width=\"0.17284\" stroke-linecap=\"round\"/>%0A<path d=\"M6.44531 11.0476C6.44531 11.0476 10.375 10.3422 14.0686 9.06804C17.7623 7.7939 20.5122 6.23373 20.5122 6.23373\" stroke=\"%23513C9F\" stroke-width=\"0.17284\" stroke-linecap=\"round\"/>%0A<path d=\"M11.6914 5.93518L9.05534 14.7068M9.05534 14.7068H15.3203M9.05534 14.7068L0.15625 26.3646\" stroke=\"%23ABABAB\" stroke-width=\"0.302474\" stroke-linecap=\"round\"/>%0A<path d=\"M6.02539 23.9646L4.85806 24.1287C5.46272 25.7287 6.70381 26.4276 8.18528 26.4276C11.8147 26.4276 10.707 22.3227 12.8103 22.3227C14.3358 22.3227 13.7155 25.6498 16.9992 25.6498C19.0029 25.6498 19.2028 23.631 18.8607 22.7625C18.8589 22.7572 18.8568 22.7524 18.8538 22.7476L18.3166 21.9253C18.2817 21.8706 18.1968 21.8912 18.1907 21.9562L18.0908 22.9529C18.0838 23.0222 18.0857 23.0913 18.0936 23.1605C18.1764 23.8491 18.2291 25.5202 16.9992 25.5202C15.7015 25.5202 15.3895 22.2362 12.8103 22.2362C9.78393 22.2362 10.1726 26.298 8.31487 26.298C7.08938 26.298 6.15447 24.9153 6.02539 23.9646Z\" fill=\"url(%23paint3_linear)\"/>%0A<defs>%0A<linearGradient id=\"paint0_linear\" x1=\"15.5372\" y1=\"5.0278\" x2=\"12.0802\" y2=\"14.534\" gradientUnits=\"userSpaceOnUse\">%0A<stop stop-color=\"%236430AB\"/><stop offset=\"1\" stop-color=\"%23AA89D8\"/>%0A</linearGradient>%0A<linearGradient id=\"paint1_linear\" x1=\"12.8583\" y1=\"10.3858\" x2=\"8.40764\" y2=\"18.9846\" gradientUnits=\"userSpaceOnUse\">%0A<stop stop-color=\"%23005DBB\"/><stop offset=\"1\" stop-color=\"%233D92E8\"/>%0A</linearGradient>%0A<linearGradient id=\"paint2_linear\" x1=\"14.8452\" y1=\"5.02774\" x2=\"13.5047\" y2=\"9.21911\" gradientUnits=\"userSpaceOnUse\">%0A<stop stop-color=\"%231B70C4\"/><stop offset=\"1\" stop-color=\"%2354A4F2\"/>%0A</linearGradient>%0A<linearGradient id=\"paint3_linear\" x1=\"4.85806\" y1=\"24.2455\" x2=\"18.9963\" y2=\"24.2455\" gradientUnits=\"userSpaceOnUse\">%0A<stop stop-color=\"%234497EA\"/><stop offset=\"0.254755\" stop-color=\"%231463B2\"/>%0A<stop offset=\"0.498725\" stop-color=\"%230A437D\"/><stop offset=\"0.666667\" stop-color=\"%232476C8\"/>%0A<stop offset=\"0.972542\" stop-color=\"%230C549A\"/>%0A</linearGradient>%0A</defs>%0A</svg>%0A"