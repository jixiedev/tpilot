# Local Next.js dev env for the CopilotKit v2 frontend.
#
# Why these values are set:
# - LANGGRAPH_DEPLOYMENT_URL points at the `langgraph dev` server we run
#   alongside `npm run dev` in another terminal. Use 127.0.0.1 (not
#   localhost) so Node 18+ fetch skips the IPv6 lookup that langgraph
#   dev does not bind to; on macOS this otherwise takes 20+ seconds to
#   fail and the front-end shows
#   "Unable to connect to LangGraph server".
# - LANGSMITH_TRACING=false silences the
#   `Failed to send compressed multipart ingest: 403 Forbidden` warning
#   when running without a LangSmith API key.

LANGGRAPH_DEPLOYMENT_URL=http://127.0.0.1:8000
LANGSMITH_TRACING=false
LANGCHAIN_TRACING_V2=false
COPILOTKIT_TELEMETRY_DISABLED=true
