{
  "airflow_tahoe": {
    "transport": "stdio",
    "command": "/Users/cdpac/.local/bin/uv",
    "args": [
      "run",
      "--directory",
      "/Users/cdpac/sbox/airflow-mcp-server",
      "airflow-mcp-server",
      "--safe",
      "--static-tools",
      "--base-url",
      "https://airflow.s.tahoe.wish.site/api/v1",
      "--auth-token",
      "${AIRFLOW_MCP_AUTH_TOKEN}"
    ]
  },
  "airflow_legacy": {
    "transport": "stdio",
    "command": "/Users/cdpac/.local/bin/uv",
    "args": [
      "run",
      "--directory",
      "/Users/cdpac/sbox/airflow-mcp-server",
      "airflow-mcp-server",
      "--safe",
      "--static-tools",
      "--base-url",
      "https://airflow.s.legacy.wish.site/api/v1",
      "--auth-token",
      "${AIRFLOW_LEGACY_MCP_AUTH_TOKEN}"
    ]
  },
  "datahub": {
    "_comment": "DataHub MCP server — temporarily disabled. The agent binds native datahub_* tools instead (see tools/external/datahub.py). To re-enable, move this block back into mcp.json and re-add 'datahub' to accepted_mcp in agent/registry.py.",
    "transport": "stdio",
    "command": "/Users/cdpac/.local/bin/uvx",
    "args": ["mcp-server-datahub"],
    "env": {
      "DATAHUB_GMS_URL": "https://datahub.s.tahoe.wish.site:8080",
      "DATAHUB_GMS_TOKEN": "${DATAHUB_GMS_TOKEN}",
      "SSL_CERT_FILE": "/Users/cdpac/wbox/tpilot/tools/mcp/ssl/cacert.pem"
    }
  }
}
