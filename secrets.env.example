# TahoePilot secrets: copy to secrets.env (git-ignored) and fill in, or provide the same
# names as real environment variables (k8s Secret via envFrom). The path is set by
# TAHOEPILOT_SECRETS_FILE in .env (default /tahoepilot/secrets/secrets.env).
# Each name is referenced from a config file; unused ones can be left out.

# LLM providers (config/models.toml api_key_env)
MiniMax_API_KEY=
GLM_API_KEY=
OpenRouter_API_KEY=
SenseNova_API_KEY=

# Data tools (config/tools.toml *_env)
TRINO_USER=
TRINO_PASSWORD=
DATAHUB_GMS_TOKEN=
TAVILY_API_KEY=
BRAVE_API_KEY=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# RAG (config/rag.toml [qdrant].api_key_env)
QDRANT_API_KEY=

# MCP servers (${VAR} in config/mcp.json)
AIRFLOW_MCP_AUTH_TOKEN=
AIRFLOW_LEGACY_MCP_AUTH_TOKEN=

# Web login ([auth] in server.toml): HMAC key signing session tokens, 32+ characters.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
TAHOEPILOT_SESSION_SECRET=
# Web login: password of the LDAP service account that looks users up ([auth].bind_user).
LDAP_BIND_PASSWORD=

# Tracing (read by LangSmith itself)
LANGSMITH_API_KEY=

# Not referenced by config/ today
INTELLIGENCE_API_KEY=
